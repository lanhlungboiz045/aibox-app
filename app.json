{
  "expo": {
    "name": "AIBox",
    "slug": "aibox-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "backgroundColor": "#0F1115",
      "barStyle": "light-content"
    },
    "newArchEnabled": true,
    "scheme": "aibox",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F1115"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aibox.app"
    },
    "android": {
      "package": "com.aibox.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115"
      }
    },
    "plugins": [
      "expo-navigation-bar",
      "@react-native-google-signin/google-signin"
    ]
  }
}
