# === Firebase (dán từ Firebase Console → Project settings → Your apps) ===
# Tạo Web App trong project Firebase rồi copy 6 giá trị dưới đây.
# Đây là config công khai (không phải bí mật); bảo mật thật nằm ở firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# === Google Sign-In ===
# Web client ID: Firebase Console → Authentication → Sign-in method → Google
#                → Web SDK configuration → Web client ID
# Dạng: 1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Email được cấp role System Admin ngay lần đăng nhập đầu tiên.
# Nhiều email thì cách nhau bằng dấu phẩy.
# Ví dụ: EXPO_PUBLIC_ADMIN_EMAILS=ban@gmail.com,phu@gmail.com
EXPO_PUBLIC_ADMIN_EMAILS=

# === AI thật (OpenAI-compatible) ===
# Để trống cả 3 dòng đầu → app dùng câu trả lời MOCK (vẫn demo được).
# Điền Base URL + API key → app gọi AI thật trong AI Hub và Market Analyst.
# Có thể nhập trực tiếp trong app: Profile → Cấu hình AI (khuyến nghị khi test trên máy).
#
# Ví dụ:
#   OpenAI        https://api.openai.com/v1                        gpt-4o-mini
#   OpenRouter    https://openrouter.ai/api/v1                     openai/gpt-4o-mini
#   DeepSeek      https://api.deepseek.com/v1                      deepseek-chat
#   Groq          https://api.groq.com/openai/v1                   llama-3.3-70b-versatile
#   Gemini        https://generativelanguage.googleapis.com/v1beta/openai   gemini-3.1-flash-lite
#   Pollinations  https://text.pollinations.ai/openai               openai    (không cần key)
#   Ollama (LAN)  http://192.168.1.10:11434/v1                     llama3.1   (không cần key)
EXPO_PUBLIC_AI_BASE_URL=
EXPO_PUBLIC_AI_API_KEY=
EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
# true (mặc định): mọi model trong app đều gọi bằng EXPO_PUBLIC_AI_MODEL
# false: map tên model đã chọn sang model thật (hữu ích với OpenRouter/gateway đa model)
EXPO_PUBLIC_AI_FORCE_MODEL=true
# Prompt hệ thống mặc định (tùy chọn)
# EXPO_PUBLIC_AI_SYSTEM_PROMPT=Bạn là trợ lý AIBox...

# === Giao diện (tùy chọn) ===
# Bỏ trống → tự theo Dark/Light của hệ điều hành.
# Ép để test 1 theme: light hoặc dark (đổi xong cần mở lại app).
# EXPO_PUBLIC_THEME=light
# Ngôn ngữ: vi (mặc định) hoặc en. Đổi xong restart Metro (-c).
# EXPO_PUBLIC_LANG=en
