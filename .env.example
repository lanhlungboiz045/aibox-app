# === Firebase (dán từ Firebase Console → Project settings → Your apps) ===
# Tạo Web App trong project Firebase rồi copy 6 giá trị dưới đây.
# Đây là config công khai (không phải bí mật); bảo mật thật nằm ở firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# === Google Sign-In ===
# Web client ID: Firebase Console → Authentication → Sign-in method → Google
#                → Web SDK configuration → Web client ID
# Dạng: 1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Email được cấp role System Admin ngay lần đăng nhập đầu tiên.
# Nhiều email thì cách nhau bằng dấu phẩy.
# Ví dụ: EXPO_PUBLIC_ADMIN_EMAILS=ban@gmail.com,phu@gmail.com
EXPO_PUBLIC_ADMIN_EMAILS=
